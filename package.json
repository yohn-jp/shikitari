{
  "name": "shikitari",
  "version": "0.1.0",
  "description": "A minimal TypeScript CLI foundation for Shikitari.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "shikitari": "dist/cli-entry.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "start": "node dist/cli-entry.js",
    "test": "node --test --import tsx 'src/**/*.test.ts' 'scripts/**/*.test.mjs'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.mjs' 'eslint.config.mjs'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke-test": "node scripts/smoke-test.mjs",
    "test:package": "pnpm run build && node scripts/run-package-suite.mjs",
    "governance:actions": "node scripts/validate-actions.mjs",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run governance:actions && pnpm run test:package",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yohn-jp/shikitari.git"
  },
  "homepage": "https://github.com/yohn-jp/shikitari#readme",
  "bugs": {
    "url": "https://github.com/yohn-jp/shikitari/issues"
  },
  "keywords": [
    "cli",
    "typescript",
    "developer-tools"
  ]
}
